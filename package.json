{
  "name": "arc-transaction-observer",
  "version": "0.2.0",
  "private": true,
  "description": "Arc Testnet RPC, gas, USDC accounting, receipt tracking and onchain observation tooling",
  "type": "module",
  "scripts": {
    "health": "tsx src/health.ts",
    "receipt": "tsx src/receipt.ts",
    "build": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "deploy:registry": "node scripts/deploy.mjs",
    "verify:registry": "node scripts/verify.mjs"
  },
  "dependencies": {
    "ethers": "6.15.0",
    "solc": "0.8.30"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "tsx": "^4.20.5",
    "typescript": "^6.0.2"
  }
}
